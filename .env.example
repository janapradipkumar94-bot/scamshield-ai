# ScamShield AI Environment Configuration
PROJECT_NAME="ScamShield AI"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="scamshield-super-secure-change-in-production-key-random-bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (MongoDB)
# Local or MongoDB Atlas URI:
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="scamshield_ai"

# CORS configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Rate Limiting & Limits
RATE_LIMIT_PER_MINUTE=60
MAX_TEXT_LENGTH=10000

# Initial Admin Seed Configuration (created if not exists)
ADMIN_EMAIL="admin@scamshield.ai"
ADMIN_PASSWORD="AdminSecurePassword123!"
